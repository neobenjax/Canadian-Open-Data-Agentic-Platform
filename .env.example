# ==============================================================================
# Canadian Open Data Agentic Platform — Environment Template (.env.example)
# Copy this file to '.env' and fill in your personal credentials:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Linear.app Personal API Key
# ------------------------------------------------------------------------------
# Required for running 'python scripts/sync_tasks.py' and synchronizing task state.
# Free Tier: Personal API Keys are 100% free with full read/write access.
#
# Steps to generate:
#   1. Visit: https://linear.app/canopendataagenticplatform/settings/api
#   2. Under "Personal API keys", click "Create Key"
#   3. Label it "Agent-Key" (or your name)
#   4. Paste your key below:
LINEAR_API_KEY=lin_api_YOUR_LINEAR_API_KEY_HERE

# ------------------------------------------------------------------------------
# 2. Team Member Identification
# ------------------------------------------------------------------------------
# Specify your name to automatically filter your tasks in sync_tasks.py
# Options:
#   - Benjamin Sanchez Zebadua
#   - Samir Ibrahim
#   - Yassir Tagelsir Khougali
CANDATA_TEAM_MEMBER=Your Name Here

# ------------------------------------------------------------------------------
# 3. GitHub Personal Access Token (for GitHub MCP & Automated PR Creation)
# ------------------------------------------------------------------------------
# Required for:
#   - Running 'python scripts/sync_tasks.py --create-pr CAN-XX'
#   - Enabling the GitHub MCP server (github-mcp-server) for AI agents (Cursor, Claude Code, Antigravity)
#
# Steps to generate:
#   1. Visit: https://github.com/settings/tokens (Personal access tokens -> Tokens classic)
#   2. Click "Generate new token (classic)"
#   3. Select scope: 'repo' (Full control of private repositories)
#   4. Generate and paste your token below:
GITHUB_TOKEN=ghp_YOUR_GITHUB_PERSONAL_ACCESS_TOKEN_HERE
