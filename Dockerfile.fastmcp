# syntax=docker/dockerfile:1.7
# Symlink-equivalent entrypoint for docker/Dockerfile.fastmcp
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder

WORKDIR /build

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --no-dev

COPY packages/candata-mcp ./packages/candata-mcp
COPY packages/agent-orchestrator ./packages/agent-orchestrator
COPY scripts ./scripts
COPY governance.json ./

RUN uv sync --frozen --no-dev

FROM python:3.12-slim-bookworm AS runtime

LABEL org.opencontainers.image.title="CanData-MCP Server" \
      org.opencontainers.image.description="FastMCP 2.0 in-memory DuckDB slicing server for official Canadian civic data" \
      org.opencontainers.image.source="https://github.com/neobenjax/Canadian-Open-Data-Agentic-Platform"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH" \
    HOME="/home/candata"

RUN groupadd --gid 10001 --system candata && \
    useradd --uid 10001 --system --gid candata --create-home --home-dir /home/candata candata && \
    mkdir -p /app /app/tmp && \
    chown -R candata:candata /app /home/candata

WORKDIR /app

COPY --from=builder --chown=candata:candata /app/.venv /app/.venv
COPY --from=builder --chown=candata:candata /build/packages/candata-mcp /app/packages/candata-mcp
COPY --from=builder --chown=candata:candata /build/governance.json /app/governance.json

USER 10001:10001

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD python -c "import candata_mcp.server; import duckdb; con = duckdb.connect(':memory:'); assert con.execute('SELECT 1').fetchone()[0] == 1" || exit 1

ENTRYPOINT ["candata-mcp"]
